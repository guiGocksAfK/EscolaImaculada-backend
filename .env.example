# Copie para .env e ajuste conforme necessário
# Em produção use TLS na conexão: acrescente &sslmode=require (ou verify-full) à URL.
DATABASE_URL="postgresql://escola:escola@localhost:5432/escola_imaculada?schema=public"
# Mínimo 32 caracteres. Gere um real com: openssl rand -base64 48
JWT_SECRET="gere-um-segredo-real-com-openssl-rand-base64-48"
JWT_EXPIRES_IN="8h"
PORT=3000

# Defina como "production" no ambiente de deploy — habilita validações extras
# no boot (ex.: recusa subir com CORS_ORIGIN ou DATABASE_URL de localhost).
# NODE_ENV=production

# Origem(ns) permitida(s) pelo CORS, separadas por vírgula. Sem isso cai no
# default http://localhost:4200 — em produção é OBRIGATÓRIO trocar pelo(s)
# domínio(s) real(is) do frontend (ex.: https://escolaimaculada.vercel.app).
CORS_ORIGIN="http://localhost:4200"

# Requisições por minuto por IP (padrão global). Rotas de /auth têm limite próprio menor.
THROTTLE_TTL=60
THROTTLE_LIMIT=120
THROTTLE_AUTH_LIMIT=5
# Desliga o rate limit por completo — use só para rodar test/smoke.sh.
# RATE_LIMIT_DISABLED=1

# Defina como 1 (ou o nº de proxies) SOMENTE se a API rodar atrás de um reverse
# proxy (Render, Railway, nginx, etc. — qualquer PaaS conta como proxy).
# Sem proxy, deixe em branco — senão o rate limit pode ser furado via X-Forwarded-For.
# TRUST_PROXY=1
