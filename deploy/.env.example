# Copie pra deploy/.env na VM (cp .env.example .env) e preencha.
# O .env NUNCA vai pro git (já está no .gitignore).

# Banco no Neon (São Paulo), string pooled com sslmode=require.
# Formato: postgresql://USUARIO:SENHA@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Mínimo 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Domínio do front na Vercel (separe por vírgula se tiver mais de um).
CORS_ORIGIN=

# Liga as validações extras de produção no boot.
NODE_ENV=production

# A API roda atrás do Caddy: sem isso o rate limit veria o IP do proxy,
# e não o de quem acessa.
TRUST_PROXY=1

# --- Backup (deploy/backup.sh, disparado pelo escola-backup.timer) -----------

# A MESMA URL do Neon, mas a DIRETA — sem "-pooler" no host. O pooler do Neon
# e pgbouncer em modo transacao, e o pg_dump nao funciona atraves dele.
# Formato: postgresql://USUARIO:SENHA@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_DIRETA=

# Chave PUBLICA do age (age1...). Gere o par com `age-keygen -o chave-backup.txt`.
# A PRIVADA nao fica na VM: guarde no gerenciador de senhas, com uma segunda
# copia em outro lugar. Sem ela nao existe restauracao.
BACKUP_AGE_PUBKEY=

# Bucket do Backblaze B2 e a chave de aplicacao restrita a ele.
# Deixe B2_BUCKET vazio para manter o backup so na VM.
B2_BUCKET=
B2_KEY_ID=
B2_APP_KEY=

# Dead man's switch (healthchecks.io): o script pinga ao terminar bem e
# pinga /fail se quebrar. Sem isso, um backup que parou passa despercebido.
HEALTHCHECK_URL=

# Opcionais (os valores abaixo sao os padroes do script).
# BACKUP_DIR=/var/backups/escola
# BACKUP_RETENCAO_DIAS=14
# Precisa casar com a versao do Postgres do Neon (veja no painel ou rode
# `SELECT version()`); cliente mais antigo que o servidor recusa o dump.
# BACKUP_PG_IMAGE=postgres:17-alpine
