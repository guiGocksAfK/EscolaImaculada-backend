// Sistema de Registro de Classe — Escola Imaculada
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // Os imports internos do client precisam apontar pra ".js": o código gerado é
  // TypeScript, e o tsc NÃO reescreve extensões ao compilar. Sem isso, o build
  // de produção gera dist/.../client.js importando um ".ts" que não existe lá,
  // e a API morre no boot com ERR_MODULE_NOT_FOUND.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Papel {
  DIRETORA
  PROFESSORA
}

enum Periodo {
  MANHA
  TARDE
  INTEGRAL
}

enum StatusAluno {
  ATIVO
  TRANSFERIDO
  DESISTENTE
}

/// C = compareceu, F = falta, D = desistente
enum StatusDia {
  C
  F
  D
}

// ---------------------------------------------------------------------------
// Entidades
// ---------------------------------------------------------------------------

model Escola {
  id       String   @id @default(uuid())
  nome     String
  endereco String
  criadoEm DateTime @default(now())

  usuarios Usuario[]
  turmas   Turma[]
}

model Usuario {
  id             String   @id @default(uuid())
  nome           String
  cpf            String   @unique
  dataNascimento String // ISO date (YYYY-MM-DD)
  senhaHash      String
  versaoSessao   Int      @default(0)
  papel          Papel
  criadoEm       DateTime @default(now())

  escolaId String
  escola   Escola @relation(fields: [escolaId], references: [id])

  turmas Turma[] @relation("TurmaProfessora")
}

model Turma {
  id        String   @id @default(uuid())
  nome      String // ex: "Infantil 5 - Tarde"
  periodo   Periodo
  anoLetivo Int
  criadoEm  DateTime @default(now())

  professoraId String
  professora   Usuario @relation("TurmaProfessora", fields: [professoraId], references: [id])

  escolaId String
  escola   Escola @relation(fields: [escolaId], references: [id])

  alunos    Aluno[]
  chamadas  RegistroChamada[]
  conteudos RegistroConteudo[]
  avaliacoes Avaliacao[]
  matriculas Matricula[]
  diasChamada DiaChamada[]
}

model Aluno {
  id              String      @id @default(uuid())
  nome            String
  cpf             String
  dataNascimento  String // ISO date (YYYY-MM-DD)
  nomePai         String
  nomeMae         String
  localNascimento String
  endereco        String
  status          StatusAluno @default(ATIVO)
  criadoEm        DateTime    @default(now())

  turmaId String
  turma   Turma  @relation(fields: [turmaId], references: [id])

  chamadas           RegistroChamada[]
  avaliacoes         Avaliacao[]
  faltasJustificadas FaltaJustificada[]
  matriculas Matricula[]
}

// Intervalo [inicio, fim): mudanças valem na data da alteração.
model Matricula {
  id String @id @default(uuid())
  alunoId String
  aluno Aluno @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  turmaId String
  turma Turma @relation(fields: [turmaId], references: [id])
  inicio String
  fim String?
  @@index([turmaId, inicio, fim])
}

// A existência do cabeçalho sela o lançamento, mesmo após exclusões de alunos.
model DiaChamada {
  turmaId String
  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  data String
  registros RegistroChamada[]
  @@id([turmaId, data])
}

model RegistroChamada {
  id     String    @id @default(uuid())
  data   String // ISO date (YYYY-MM-DD)
  status StatusDia

  turmaId String
  turma   Turma  @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  alunoId String
  aluno   Aluno  @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  dia DiaChamada @relation(fields: [turmaId, data], references: [turmaId, data], onDelete: Cascade)
  justificativa FaltaJustificada?

  @@unique([turmaId, alunoId, data])
  @@index([turmaId, data])
}

model RegistroConteudo {
  id   String @id @default(uuid())
  data String // ISO date (YYYY-MM-DD)

  /// Texto renderizado a partir dos campos abaixo — usado para exibição,
  /// PDF e busca. Sempre gerado pelo servidor; registros antigos só têm ele.
  conteudo String

  // Campos de experiência da BNCC (Educação Infantil). Opcionais: um
  // registro precisa de ao menos um preenchido.
  disciplina  String?
  euOutroNos  String?
  corpoGestos String?
  tracosSons  String?
  escutaFala  String?
  espacoTempo String?
  outras      String?

  turmaId String
  turma   Turma  @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@index([turmaId, data])
}

model Avaliacao {
  id         String @id @default(uuid())
  texto      String
  referencia String // ex: "1º semestre 2026"

  alunoId String
  aluno   Aluno  @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  turmaId String
  turma   Turma  @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@index([turmaId])
  @@index([alunoId])
}

model FaltaJustificada {
  id     String @id @default(uuid())
  data   String // ISO date (YYYY-MM-DD)
  motivo String
  registroChamadaId String @unique
  registroChamada RegistroChamada @relation(fields: [registroChamadaId], references: [id], onDelete: Cascade)

  alunoId String
  aluno   Aluno  @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@index([alunoId])
}

/// Trilha de auditoria das operações de escrita (LGPD: rastreabilidade).
/// Os dados do autor são "congelados" (sem FK) para o registro sobreviver
/// mesmo que o usuário seja excluído depois.
model RegistroAuditoria {
  id          String   @id @default(uuid())
  criadoEm    DateTime @default(now())

  usuarioId   String
  usuarioNome String
  papel       Papel
  escolaId    String

  metodo     String // POST | PUT | PATCH | DELETE
  rota       String // rota com placeholders, ex: /alunos/:id
  caminho    String // caminho real chamado, ex: /alunos/abc-123
  statusCode Int
  ip         String?

  @@index([escolaId, criadoEm])
  @@index([usuarioId, criadoEm])
}
